{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "proseWrap": "never",
  "singleQuote": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/**",
    ".tmp-*/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/shots/**",
    "**/test/fixtures/**",
    "evals/agent-review/fixtures/**",
    "extension/src/panel-shots.test.ts",
    "docs/spec.md"
  ]
}
