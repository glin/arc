{
  "name": "@glin/arc",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "description": "Command-line status surfaces for Arc.",
  "bin": {
    "arc": "dist/arc-status.cjs",
    "arc-status": "dist/arc-status.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run test/status.test.ts test/stream-fixtures.test.mjs test/cost.test.ts",
    "test:smoke": "npm run build && vitest run test/smoke.test.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:smoke"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "4.1.11"
  }
}
