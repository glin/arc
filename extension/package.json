        "command": "arc.pinSession",
        "title": "Pin to top",
        "category": "Arc Session"
      },
      {
        "command": "arc.unpinSession",
        "title": "Unpin",
        "category": "Arc Session"
      },
      {
        "command": "arc.resetPanelState",
        "title": "Reset Panel State",
        "category": "Arc"
      },
      {
        "command": "arc.goBack",
        "title": "Go back",
        "category": "Arc",
        "icon": "$(arrow-left)"
      },
      {
        "command": "arc.goForward",
        "title": "Go forward",
        "category": "Arc",
        "icon": "$(arrow-right)"
      },
      {
        "command": "arc.exportSession",
        "title": "Export session as HTML...",
        "category": "Arc Session"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "arc.goBack",
          "when": "activeWebviewPanelId == arc.panel",
          "group": "navigation@1"
        },
        {
          "command": "arc.goForward",
          "when": "activeWebviewPanelId == arc.panel",
          "group": "navigation@2"
        },
        {
          "command": "arc.openInEditor",
          "when": "activeWebviewPanelId != arc.panel",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "arc.addToArc",
          "when": "resourceScheme == file",
          "group": "6_arc@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "arc.addToArc",
          "when": "resourceScheme == file",
          "group": "6_arc@1"
        }
      ],
      "webview/context": [
        {
          "command": "arc.copyPath",
          "when": "webviewSection == 'arcFile'",
          "group": "5_copypath@1"
        },
        {
          "command": "arc.copyRelativePath",
          "when": "webviewSection == 'arcFile'",
          "group": "5_copypath@2"
        },
        {
          "command": "arc.copyLink",
          "when": "arcCopyLink && link",
          "group": "5_copypath@0"
        },
        {
          "command": "arc.sendResponseLinkWithLabels",
          "when": "webviewSection == 'arcLink' && link && session && key",
          "group": "4_handoff@1"
        },
        {
          "command": "arc.sendResponseLink",
          "when": "webviewSection == 'arcLink' && link && session && key",
          "group": "4_handoff@2"
        },
        {
          "command": "arc.sendSelectedTextWithLabels",
          "when": "arcSelection && session && key && webviewSection != 'arcLink'",
          "group": "4_handoff@1"
        },
        {
          "command": "arc.sendSelectedText",
          "when": "arcSelection && session && key && webviewSection != 'arcLink'",
          "group": "4_handoff@2"
        },
        {
          "command": "arc.newSessionWithLabels",
          "when": "session && key && webviewSection != 'arcLink' && webviewSection != 'arcTableLink' && webviewSection != 'arcFile' && !arcSelection",
          "group": "4_handoff@3"
        },
        {
          "command": "arc.copyPath",
          "when": "webviewSection == 'arcLink'",
          "group": "5_copypath@1"
        },
        {
          "command": "arc.copyRelativePath",
          "when": "webviewSection == 'arcLink'",
          "group": "5_copypath@2"
        },
        {
          "command": "arc.markTurnRead",
          "when": "webviewSection == 'arcTurnUnread' || webviewSection == 'arcTurnUnreadSummary'",
          "group": "1_read@1"
        },
        {
          "command": "arc.markTurnUnread",
          "when": "webviewSection == 'arcTurnRead' || webviewSection == 'arcTurnReadSummary'",
          "group": "1_read@1"
        },
        {
          "command": "arc.copyTurnSummary",
          "when": "webviewSection == 'arcTurnReadSummary' || webviewSection == 'arcTurnUnreadSummary' || webviewSection == 'arcTurnSummary'",
          "group": "2_copy@1"
        },
        {
          "command": "arc.commentOnTurn",
          "when": "arcTurn",
          "group": "3_comment@1"
        },
        {
          "command": "arc.copyTurnComments",
          "when": "arcComments",
          "group": "3_comment@2"
        },
        {
          "command": "arc.pinSession",
          "when": "webviewSection == 'arcSessionLive' && !sessionPinned",
          "group": "1_triage@1"
        },
        {
          "command": "arc.unpinSession",
          "when": "webviewSection == 'arcSessionLive' && sessionPinned",
          "group": "1_triage@1"
        },
        {
          "command": "arc.pinSession",
          "when": "(webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail') && !sessionPinned && !sessionArchived",
          "group": "1_triage@1"
        },
        {
          "command": "arc.unpinSession",
          "when": "(webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail') && sessionPinned && !sessionArchived",
          "group": "1_triage@1"
        },
        {
          "command": "arc.markSessionRead",
          "when": "(webviewSection == 'arcSessionLive' || webviewSection == 'arcSessionArchived') && sessionRead == 'unread'",
          "group": "1_triage@2"
        },
        {
          "command": "arc.markSessionUnread",
          "when": "(webviewSection == 'arcSessionLive' || webviewSection == 'arcSessionArchived') && sessionRead == 'read'",
          "group": "1_triage@2"
        },
        {
          "command": "arc.markSessionRead",
          "when": "webviewSection == 'arcRailUnread'",
          "group": "1_triage@2"
        },
        {
          "command": "arc.markSessionUnread",
          "when": "webviewSection == 'arcRailRead'",
          "group": "1_triage@2"
        },
        {
          "command": "arc.archiveSession",
          "when": "webviewSection == 'arcSessionLive'",
          "group": "1_triage@3"
        },
        {
          "command": "arc.unarchiveSession",
          "when": "webviewSection == 'arcSessionArchived'",
          "group": "1_triage@3"
        },
        {
          "command": "arc.archiveSession",
          "when": "(webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail') && !sessionArchived",
          "group": "1_triage@3"
        },
        {
          "command": "arc.unarchiveSession",
          "when": "(webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail') && sessionArchived",
          "group": "1_triage@3"
        },
        {
          "command": "arc.renameSession",
          "when": "sessionPersisted && (webviewSection == 'arcSessionLive' || webviewSection == 'arcSessionArchived')",
          "group": "2_edit@1"
        },
        {
          "command": "arc.renameSession",
          "when": "sessionPersisted && (webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail')",
          "group": "2_edit@1"
        },
        {
          "command": "arc.labelSession",
          "when": "webviewSection == 'arcSessionLive'",
          "group": "2_edit@2"
        },
        {
          "command": "arc.labelSession",
          "when": "webviewSection == 'arcSessionArchived'",
          "group": "2_edit@2"
        },
        {
          "command": "arc.labelSession",
          "when": "webviewSection == 'arcRailUnread'",
          "group": "2_edit@2"
        },
        {
          "command": "arc.labelSession",
          "when": "webviewSection == 'arcRailRead'",
          "group": "2_edit@2"
        },
        {
          "command": "arc.labelSession",
          "when": "webviewSection == 'arcRail'",
          "group": "2_edit@2"
        },
        {
          "command": "arc.newSessionWithLabels",
          "when": "session && (webviewSection == 'arcSessionLive' || webviewSection == 'arcSessionArchived')",
          "group": "3_new@1"
        },
        {
          "command": "arc.newSessionWithLabels",
          "when": "session && (webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail')",
          "group": "3_new@1"
        },
        {
          "command": "arc.copySessionId",
          "when": "webviewSection == 'arcSessionLive' || webviewSection == 'arcSessionArchived'",
          "group": "z_details@1"
        },
        {
          "command": "arc.copySessionId",
          "when": "webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail'",
          "group": "z_details@1"
        },
        {
          "command": "arc.showSessionDetails",
          "when": "webviewSection == 'arcSessionLive' || webviewSection == 'arcSessionArchived'",
          "group": "z_details@2"
        },
        {
          "command": "arc.showSessionDetails",
          "when": "webviewSection == 'arcRailUnread' || webviewSection == 'arcRailRead' || webviewSection == 'arcRail'",
          "group": "z_details@2"
        },
        {
          "command": "arc.renameView",
          "when": "webviewSection == 'arcRailView' && view",
          "group": "7_view@1"
        },
        {
          "command": "arc.deleteView",
          "when": "webviewSection == 'arcRailView' && view",
          "group": "7_view@2"
        },
        {
          "command": "arc.hideComposer",
          "when": "webviewSection == 'arcComposer'",
          "group": "1_composer@1"
        },
        {
          "command": "arc.showComposer",
          "when": "webviewSection == 'arcComposerHidden'",
          "group": "1_composer@1"
        },
        {
          "command": "arc.exportSession",
          "when": "sessionPersisted && (webviewSection == 'arcSessionLive' || webviewSection == 'arcSessionArchived')",
          "group": "zz_export@1"
        }
      ],
      "commandPalette": [
        {
          "command": "arc.setupCommands",
          "when": "true"
