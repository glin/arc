{
  "name": "arc",
  "displayName": "Arc",
  "description": "Arc runs parallel coding agents in VS Code.",
  "version": "0.1.0",
  "publisher": "glin",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Arc",
      "properties": {
        "arc.maxSessions": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "How many recent sessions the panel keeps up to date. A pinned or open session remains available in addition to this limit."
        },
        "arc.projectCost.historyDays": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "How many days of transcript history Project cost reads. 0 reads all history. Project cost skips a transcript that last changed before the limit. A period that starts before the limit shows its cost as a lower bound."
        },
        "arc.diagnostics.log": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Write a diagnostics log while you investigate a slow panel. Each editor window writes its own file under `~/.arc/logs`, and Arc keeps the newest 20 files. Reload the window after you change this. Leave this off for normal work."
        },
        "arc.agentIdleMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "How many idle minutes a session process stays open after a turn finishes. Archived sessions close as soon as their current work finishes."
        },
        "arc.sessionCacheMiB": {
          "type": "integer",
          "default": 16,
          "minimum": 1,
          "maximum": 256,
          "description": "How much memory, in MiB, keeps recently viewed sessions ready. Returning to a kept session shows it without reading its transcript again. The session on screen always stays. The least recently viewed session is released first."
        },
        "arc.timeline.cardLayout": {
          "type": "string",
          "enum": [
            "compact",
            "one-column",
            "two-columns"
          ],
          "enumItemLabels": [
            "Compact",
            "One column",
            "Two columns"
          ],
          "enumDescriptions": [
            "The card keeps its subagents, commits and files in the popovers under the figures in the card's top row.",
            "The card lists its subagents, commits and files under Activity.",
            "The card lists its subagents, commits and files beside the response on a wide card, and under Activity on a narrow one."
          ],
          "default": "two-columns",
          "description": "How an open turn card shows its subagents, commits and files. Compact keeps them in the popovers under the figures in the card's top row. One column and Two columns list them in the card."
        },
        "arc.timeline.promptPosition": {
          "type": "string",
          "enum": [
            "above",
            "below"
          ],
          "enumItemLabels": [
            "Above the response",
            "Below the response"
          ],
          "enumDescriptions": [
            "The prompt leads the card, clamped to two lines.",
            "The prompt follows the response, under its opening heading."
          ],
          "default": "below",
          "description": "Where an open turn card shows the prompt that started the turn: above the response, or below it."
        },
        "arc.codexPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Codex executable the panel starts when you send a prompt. On Windows, use the executable rather than a package entry. Leave empty to use `codex` on your PATH, then the official OpenAI editor extension's bundled executable, then a local Codex install."
        },
        "arc.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Claude Code executable the panel starts when you send a prompt. On Windows, use the executable rather than a package entry. Leave empty to use `claude` on your PATH, then the official Anthropic editor extension's bundled executable, then a standard local or npm install."
        }
      }
    },
    "commands": [
      {
        "command": "arc.setupCommands",
        "title": "Set up terminal commands",
        "category": "Arc"
      },
      {
        "command": "arc.setupClaudeSnapshots",
