  "scripts": {
    "check:timeline": "tsx scripts/check-timeline.ts",
    "build": "node esbuild.mjs",
    "typecheck": "node --import tsx scripts/check-webview-globals.ts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json",
    "watch": "node esbuild.mjs --watch",
    "dev": "node dev.mjs",
    "test": "node test.mjs full",
    "test:node": "node test.mjs node",
    "test:browser": "node test.mjs browser",
    "shots": "tsx scripts/panel-shots.ts",
    "tones": "tsx ../.claude/skills/panel-mockup/snapshot-css.ts shots && tsx ../.claude/skills/panel-mockup/tone-sheet.ts shots",
    "package": "node scripts/package.mjs --no-dependencies --allow-missing-repository -o arc.vsix"
  },
