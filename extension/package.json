        "mac": "ctrl+-",
        "linux": "ctrl+alt+-",
        "when": "activeWebviewPanelId == arc.panel"
      },
      {
        "command": "arc.goForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "linux": "ctrl+shift+-",
        "when": "activeWebviewPanelId == arc.panel"
      }
