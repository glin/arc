        "category": "Arc Session"
      },
      {
        "command": "arc.renameSession",
        "title": "Rename…",
        "category": "Arc Session"
      },
      {
        "command": "arc.showSessionDetails",
        "title": "Show session details",
        "category": "Arc Session"
      },
      {
        "command": "arc.copySessionId",
