{
  "name": "arc",
  "private": true,
  "description": "Development tools for the VS Code extension.",
  "scripts": {
    "eval:review": "node evals/agent-review/run.mjs",
    "prepare": "node scripts/install-git-hooks.js",
    "format": "oxfmt --config .oxfmtrc.mjs --disable-nested-config",
    "format:check": "npm run format -- --check",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "oxlint --disable-nested-config --deny-warnings",
    "lint:css": "stylelint --config .stylelintrc.cjs --max-warnings 0 \"extension/src/webview/*.css\"",
    "lint:fix": "npm run lint:js -- --fix",
    "release": "node scripts/release-version.js",
    "test": "node scripts/test-default.mjs",
    "test:iterate": "npm run test:unit",
    "test:panel-mockup": "vitest run --config .claude/skills/panel-mockup/vitest.config.mts",
    "typecheck": "node scripts/typecheck-parallel.js",
    "test:root": "vitest run --exclude test/hooks-smoke.test.js --tags-filter=\"!subprocess\"",
    "test:subprocess": "node scripts/test-subprocess.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:smoke": "vitest run test/hooks-smoke.test.js && npm --prefix cli run test:smoke",
    "test:integration": "node scripts/test-integration.mjs",
    "test:browser": "node extension/test.mjs browser",
    "test:all": "npm test && node scripts/test-integration.mjs --browser"
  },
  "devDependencies": {
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "vitest": "4.1.11"
  }
}
